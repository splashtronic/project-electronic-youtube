/*
 * Birthday Blow Surprise - Arduino Nano
 * Library: Adafruit SSD1306 + Adafruit GFX
 *
 * Wiring:
 *  OLED SSD1306 (I2C)  : SDA->A4, SCL->A5, VCC->5V/3V3, GND
 *  Sensor suara (DO)   : D2
 *  LED (+resistor 220R): D4 -> LED -> GND
 *  Buzzer passive      : D9 -> buzzer -> GND
 *  ISD1820 PLAYL       : D7   (VCC 5V, GND bersama)
 */
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

