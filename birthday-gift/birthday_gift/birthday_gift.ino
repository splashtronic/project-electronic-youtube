const uint8_t PIN_LED    = 4;
const uint8_t PIN_BUZZER = 9;
const uint8_t PIN_ISD    = 7;

const unsigned long BLOW_TARGET_MS = 1500;  // minimal tiupan
const unsigned long BLOW_GAP_MS    = 350;   // toleransi sinyal putus-putus
const unsigned long ISD_PLAY_MS    = 6000;  // lama rekaman ISD1820 (sesuaikan)

Adafruit_SSD1306 display(SCREEN_W, SCREEN_H, &Wire, -1);

